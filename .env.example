# NAMES ONLY - this file has no secrets. Set the real values in Netlify:
#   Site configuration -> Environment variables  (then redeploy)
# Never commit real keys and never paste them into index.html.

# --- Live AI customer: Google Gemini (free tier) -----------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash          # optional override
AI_PROVIDER=gemini                       # first choice: gemini | groq | openrouter | microsoft | auto | none

# --- Optional free BACKUP providers (used automatically when the first choice is rate-limited or down) ---
# Groq: free key at https://console.groq.com/keys (no card)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# OpenRouter: free key at https://openrouter.ai/keys - keep a ":free" model so nothing is ever billed
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Order after the first choice (default groq,openrouter). Set to empty for no backups.
# AI_FALLBACKS=groq,openrouter

# --- Optional: Microsoft Azure OpenAI (DISABLED unless you set this to true) ---
MICROSOFT_AI_ENABLED=false
# MICROSOFT_AI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# MICROSOFT_AI_DEPLOYMENT=
# MICROSOFT_AI_KEY=
# MICROSOFT_AI_API_VERSION=2024-10-21

# --- Optional: Google Cloud Speech-to-Text (DISABLED unless you set this to true) ---
GOOGLE_STT_ENABLED=false
# GOOGLE_STT_API_KEY=

# --- Optional: extra allowed site origins if you use a custom domain (comma separated)
# ALLOWED_ORIGINS=https://training.example.com

# --- AI Training Assistant (Gemini coach). Uses GEMINI_API_KEY above. ---
# GEMINI_TRAINING_MODEL=gemini-2.5-flash   # model used by the coach (defaults to GEMINI_MODEL)
# TRAINING_FALLBACKS=groq,openrouter       # optional free backups if Gemini fails (default: none)
# TRAINING_AI=off                          # switch the AI coach off; the built-in guidance is used
